{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/work/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(services|portfolio|seo|how-we-work|about|faq|contact)",
      "destination": "/"
    },
    {
      "source": "/pt/(servicos|portfolio|seo|como-trabalhamos|sobre|perguntas|contato)",
      "destination": "/pt"
    }
  ]
}
